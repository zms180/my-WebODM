# GeoModel 配置文件示例
# 运行环境：local（本地）、test（测试）、prod（生产）
GEOMODEL_API_ENV=local

# 服务器配置
WO_HOST=localhost
WO_PORT=8001

# 数据存储目录
WO_MEDIA_DIR=appmedia
WO_DB_DIR=dbdata
WO_NODE_DIR=

# SSL 配置（如需要 HTTPS）
WO_SSL=NO
WO_SSL_KEY=
WO_SSL_CERT=
WO_SSL_INSECURE_PORT_REDIRECT=80

# 调试模式（生产环境保持 NO）
WO_DEBUG=NO

# 开发模式（生产环境保持 NO）
WO_DEV=NO

# Redis 消息代理
WO_BROKER=redis://broker

# 默认处理节点数量
WO_DEFAULT_NODES=1

# 节点资源限制（可选）
WO_NODE_MEMORY=
WO_NODE_CPUS=

# 自定义设置文件路径（可选）
WO_SETTINGS=

# WebODM 密钥
WO_SECRET_KEY=

# ================================
# GeoModel API 配置
# ================================
# GeoModel API 端口
GEOMODEL_API_PORT=8889


# WebODM 认证信息
WEBODM_USERNAME=admin
WEBODM_PASSWORD=admin
WEBODM_TOKEN=

# Webhook 签名密钥（必须与 WebODM 配置一致）
GEOMODEL_API_WEBHOOK_SECRET=8e9377d3b93b78de79081f2c54542c302347f5ad169323032affeb77816a4cc1

# HTTP API Key
GEOMODEL_API_KEY=aaa1df2a2f47f5495edaf32c1e3bb5dffa63a4e42419755c5f7975f620820a2a

# 日志级别：DEBUG、INFO、WARNING、ERROR
GEOMODEL_API_LOG_LEVEL=INFO

# 是否启用 RabbitMQ 工作流（true/false）
GEOMODEL_API_WORKFLOW_ENABLED=true

# 数据持久化目录
GEOMODEL_API_DATA_DIR=geomodel_api_data
GEOMODEL_API_LOG_DIR=geomodel_api_logs
